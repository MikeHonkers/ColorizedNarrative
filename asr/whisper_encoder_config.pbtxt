name: "whisper_encoder"
platform: "onnxruntime_onnx"
max_batch_size: 1

input [
  {
    name: "input_features"
    data_type: TYPE_FP32
    dims: [80, 3000]
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [-1, 1500, 768]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]