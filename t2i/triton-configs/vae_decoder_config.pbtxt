name: "vae_decoder"
platform: "onnxruntime_onnx"
max_batch_size: 1
input [
  {
    name: "latent_sample"
    data_type: TYPE_FP32
    dims: [1, 4, -1, -1]
  }
]
output [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [1, 3, -1, -1]
  }
]
instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]